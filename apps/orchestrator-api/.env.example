# ---- server ----
PORT=8787
# comma-separated, or * for any (dev)
CORS_ORIGINS=http://localhost:4321

# ---- NEAR AI Cloud (OpenAI-compatible) ----
# https://docs.near.ai/cloud/quickstart  — get a key at https://cloud.near.ai
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=z-ai/glm-5.3-flash
NEARAI_API_KEY=
# 1 = deterministic fake ideas, no key needed
LLM_MOCK=1

# ---- NEAR testnet ----
# 1 = in-memory fake chain (every account starts with 10 NEAR), no relayer key needed
NEAR_MOCK=1
NEAR_RPC_URL=https://test.rpc.fastnear.com
VAULT_CONTRACT=launch-vault.your-account.testnet
FT_FACTORY_CONTRACT=ft-factory.your-account.testnet
RELAYER_ACCOUNT_ID=relayer.your-account.testnet
# ed25519:... full-access or function-call key for the relayer. NEVER commit.
RELAYER_PRIVATE_KEY=

# ---- pricing ----
# yoctoNEAR charged per generation (0.01 NEAR)
AI_COMPUTE_COST_YOCTO=10000000000000000000000
# 1e9 tokens * 1e18 decimals
TOKEN_TOTAL_SUPPLY=1000000000000000000000000000
TOKEN_DECIMALS=18
EXPLORER_BASE=https://testnet.nearblocks.io
LLM_MAX_TOKENS=500

# HMAC key for wallet session tokens (random, e.g. `openssl rand -hex 32`). Unset = random per process.
SESSION_SECRET=
