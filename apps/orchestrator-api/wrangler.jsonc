{
  // Orchestrator API as a Cloudflare Worker. Deploy: `npx wrangler deploy` from this directory.
  // Secrets (not in this file): `wrangler secret put NEARAI_API_KEY`, `wrangler secret put RELAYER_PRIVATE_KEY`,
  // `wrangler secret put KEY_ENCRYPTION_KEY` (AES-256-GCM master key for stored AI keys; README "AI keys").
  "name": "one-shot-launchpad-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Token site configs (written at launch, served by /api/site/:ticker). Namespace "yeetpad-sites".
  "kv_namespaces": [{ "binding": "SITES", "id": "39411e131b9049f3b4731d475866e58a" }],
  "vars": {
    "NEARAI_BASE_URL": "https://ollama.com/v1",
    "NEARAI_MODEL": "gemma4:31b",
    "LLM_MAX_TOKENS": "500",
    "LLM_MOCK": "0",
    "NEAR_MOCK": "0",
    "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
    "VAULT_CONTRACT": "launch-vault.osl-launchpad-5786.testnet",
    "FT_FACTORY_CONTRACT": "ft-factory.osl-launchpad-5786.testnet",
    "RELAYER_ACCOUNT_ID": "osl-launchpad-5786.testnet",
    "SITE_BASE": "https://yeetpad.fun",
    // Access gate (see README "Access gate"). LOCKED=1: only allowlisted accounts can sign in / generate / launch.
    // Allowlist = KV allow:<account> (approved in Studio → Admin, or `bun run allow <acct>`; no redeploy)
    //           ∪ ALLOWED_ACCOUNTS (bootstrap fallback) ∪ ADMIN_ACCOUNTS.
    // Admins: `bun run admin <account>.testnet && bun run deploy:api` from the repo root.
    // Testnet is OPEN for NEAR HACKATHON judging (LOCKED=0): any wallet can sign in. The shared platform AI key is
    // protected by daily per-account / per-IP idea caps (src/quota.ts; admins and agents exempt).
    "LOCKED": "0",
    "PLATFORM_IDEAS_PER_ACCOUNT_DAY": "150",
    "PLATFORM_IDEAS_PER_IP_DAY": "400",
    "ALLOWED_ACCOUNTS": "",
    "ADMIN_ACCOUNTS": "osl-e2e-mvhxupmb.testnet,sillypuma1184.testnet",
    // Autopilot agents (README "Autopilot agent"): may sign in with a function-call key limited to the vault.
    // More can be added by admins at runtime (POST /api/admin/agents). Server ceiling on an agent's daily spend:
    "AGENT_ACCOUNTS": "yeetpad-autopilot.testnet",
    "AGENT_MAX_DAILY_NEAR": "3",
    "CORS_ORIGINS": "https://yeetpad.fun,https://www.yeetpad.fun,https://one-shot-launchpad.sushmitsarmah.workers.dev,http://localhost:4321"
  },
  // ---- Mainnet: `bun run deploy:api:mainnet` (worker one-shot-launchpad-api-mainnet). Not deployed yet. ----
  // Vars are NOT inherited by wrangler envs, so everything is repeated here. Secrets (set with --env mainnet):
  // RELAYER_PRIVATE_KEY, SESSION_SECRET (new, mainnet only), NEARAI_API_KEY, KEY_ENCRYPTION_KEY (mainnet only). See docs/mainnet-deploy.md.
  "env": {
    "mainnet": {
      "name": "one-shot-launchpad-api-mainnet",
      "workers_dev": true,
      "observability": { "enabled": true },
      // Separate KV namespace "yeetpad-sites-mainnet" (sites, waitlist, allowlist, views)
      "kv_namespaces": [{ "binding": "SITES", "id": "1370f80509d14b8897360a7d4dc18b01" }],
      "vars": {
        "NEAR_NETWORK": "mainnet",
        "NEARAI_BASE_URL": "https://ollama.com/v1",
        "NEARAI_MODEL": "gemma4:31b",
        "LLM_MAX_TOKENS": "500",
        "LLM_MOCK": "0",
        "NEAR_MOCK": "0",
        "NEAR_RPC_URL": "https://rpc.mainnet.fastnear.com",
        "VAULT_CONTRACT": "vault.yeetpad.near",
        "FT_FACTORY_CONTRACT": "factory.yeetpad.near",
        "RELAYER_ACCOUNT_ID": "relayer.yeetpad.near",
        "AUTH_RECIPIENT": "vault.yeetpad.near",
        "EXPLORER_BASE": "https://nearblocks.io",
        "DCL_CONTRACT": "dclv2.ref-labs.near",
        "WNEAR_CONTRACT": "wrap.near",
        "SITE_BASE": "https://yeetpad.fun",
        "PUBLIC_API_BASE": "https://one-shot-launchpad-api-mainnet.sushmitsarmah.workers.dev",
        // Off until one tiny mainnet launch on each venue has been verified (docs/mainnet-deploy.md step 9).
        "NEARLY_ENABLED": "0",
        "NEARLY_FACTORY": "nearlytrade.near",
        "JUSTHOOT_ENABLED": "0",
        "JUSTHOOT_FACTORY": "v2-launchpad.justhoot.near",
        "LOCKED": "1",
        "ALLOWED_ACCOUNTS": "",
        // Add your own mainnet wallet here before deploying.
        "ADMIN_ACCOUNTS": "sillypuma1184.near",
        "AGENT_ACCOUNTS": "",
        "AGENT_MAX_DAILY_NEAR": "2",
        "CORS_ORIGINS": "https://yeetpad.fun,https://www.yeetpad.fun,https://one-shot-launchpad-mainnet.sushmitsarmah.workers.dev,http://localhost:4321"
      }
    }
  }
}
