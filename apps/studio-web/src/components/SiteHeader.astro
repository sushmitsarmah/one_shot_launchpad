---
import { NET_LABEL } from "../lib/config";
interface Props { page: "home" | "app" | "token" }
const { page } = Astro.props;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Yeetpad home">
      <span class="brand-mark" aria-hidden="true">🚀</span>
      <span class="brand-name">Yeet<span class="brand-hl">pad</span></span>
    </a>
    <nav class="header-nav">
      {page === "home" ? (
        <>
          <a class="nav-link hide-sm" href="#how">How it works</a>
          <a class="nav-link hide-sm" href="#faq">FAQ</a>
          <a class="btn btn-sm btn-pink" href="/app/">Go to app →</a>
        </>
      ) : (
        <>
          <span class={`pill pill-${NET_LABEL}`}>{NET_LABEL}</span>
          <a class="nav-link hide-sm" href="/app/#tokens">My tokens</a>
          <a class="btn btn-sm btn-ghost" href="/">← Home</a>
        </>
      )}
    </nav>
  </div>
</header>
