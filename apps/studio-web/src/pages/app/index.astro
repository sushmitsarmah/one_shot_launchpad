---
import Base from "../../layouts/Base.astro";
import Studio from "../../components/Studio.tsx";
import "../../styles/global.css";
import "../../styles/wallet-modal.css";
import "../../styles/waitlist.css";
---
<Base title="Studio · Yeetpad" description="Connect a NEAR wallet, top up AI credits, generate a token idea and yeet it onto NEAR testnet." page="app">
  <main class="app-main">
    <div class="app-hero">
      <h1>The <span class="hl-app">Studio</span></h1>
      <p>Prompt → idea → NEP-141 token on NEAR testnet.</p>
    </div>
    <Studio client:only="react" />
  </main>
</Base>
