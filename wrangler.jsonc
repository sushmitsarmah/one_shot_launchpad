{
  // Cloudflare Workers Builds: serves the static Astro site from apps/studio-web/dist.
  // Build command: bun install && bun run build:web    Deploy command: npx wrangler deploy
  // Only /t/* runs the Worker (per-token <head> tags for link previews); everything else is static.
  "name": "one-shot-launchpad",
  "main": "./apps/studio-web/worker/index.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./apps/studio-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/t/*"]
  },
  // Token site configs written by the API Worker (namespace yeetpad-sites). Read here, plus views:<ticker> counters.
  "kv_namespaces": [{ "binding": "SITES", "id": "39411e131b9049f3b4731d475866e58a" }],
  // Testnet site canonical origin (flip to https://testnet.yeetpad.fun when mainnet takes yeetpad.fun).
  "vars": { "SITE_ORIGIN": "https://yeetpad.fun" },
  // ---- Mainnet site: `bun run deploy:web:mainnet` builds with PUBLIC_NETWORK=mainnet and deploys worker
  // one-shot-launchpad-mainnet (workers.dev only until the domain flip in docs/mainnet-deploy.md). ----
  "env": {
    "mainnet": {
      "name": "one-shot-launchpad-mainnet",
      "kv_namespaces": [{ "binding": "SITES", "id": "1370f80509d14b8897360a7d4dc18b01" }],
      "vars": { "SITE_ORIGIN": "https://yeetpad.fun" }
    }
  }
}
