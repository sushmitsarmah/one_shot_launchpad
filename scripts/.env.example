# Parent testnet account that owns everything (create at https://testnet.mynearwallet.com)
NEAR_ACCOUNT_ID=yourname.testnet
# Its full-access key (ed25519:...). NEVER commit. e.g. from ~/.near-credentials/testnet/yourname.testnet.json
NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Optional overrides
# FT_FACTORY_ACCOUNT_ID=ft-factory.yourname.testnet
# VAULT_ACCOUNT_ID=launch-vault.yourname.testnet
# RELAYER_ACCOUNT_ID=yourname.testnet
# PLATFORM_FEE_BPS=0
# FACTORY_INITIAL_BALANCE=5
# VAULT_INITIAL_BALANCE=3
